{
  "name": "smart-step-academy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "db:start": "docker compose up -d postgres",
    "db:setup": "npm run db:start && npm run db:push && npm run db:seed",
    "db:push": "npm run db:push -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
