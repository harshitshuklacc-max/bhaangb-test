# Local (no Docker): SQLite
DATABASE_URL="file:./prisma/dev.db"
# Production (Railway/Neon): PostgreSQL — set provider to postgresql in schema.prisma
# DATABASE_URL="postgresql://user:password@host:5432/smart_step_academy"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV=development

# Cloudinary (optional for photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Step Academy <noreply@smartstepacademy.in>"

# Default admin (seeded on first deploy)
ADMIN_USERNAME=smartstep05618
ADMIN_PASSWORD=Smartedhub123
